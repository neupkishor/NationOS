rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: These rules are temporary and insecure.
    // They allow all reads and writes to your database for the next 15 days.
    // Replace with secure rules before deploying to production.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2024, 8, 3);
    }
  }
}
