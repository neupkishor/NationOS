/**
 * @fileoverview Firestore Security Rules for NationOS.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for citizen data, with families acting as organizational units.
 *  Data related to citizens (birth registrations, death registrations, residencies, etc.) is nested under /citizens/{citizenId}.
 *  Data related to families (household income, agricultural production, etc.) is nested under /families/{familyId}.
 *  Top-level collections (infrastructures, resources) are publicly readable.
 *
 * Data Structure:
 * - /families/{familyId}: Contains family-level data.
 * - /families/{familyId}/citizens/{citizenId}: Contains citizen data within a family.
 * - /citizens/{citizenId}/birthRegistrations/{birthRegistrationId}: Birth registration data for a specific citizen.
 * - /citizens/{citizenId}/deathRegistrations/{deathRegistrationId}: Death registration data for a specific citizen.
 * - /citizens/{citizenId}/residencies/{residencyId}: Residency data for a specific citizen.
 * - /citizens/{citizenId}/migrationHistories/{migrationHistoryId}: Migration history data for a specific citizen.
 * - /citizens/{citizenId}/employments/{employmentId}: Employment data for a specific citizen.
 * - /families/{familyId}/householdIncomes/{householdIncomeId}: Household income data for a family.
 * - /citizens/{citizenId}/skills/{skillId}: Skills data for a specific citizen.
 * - /citizens/{citizenId}/loanSubsidyEligibilities/{loanSubsidyEligibilityId}: Loan subsidy eligibility data for a specific citizen.
 * - /families/{familyId}/agriculturalProductions/{agriculturalProductionId}: Agricultural production data for a family.
 * - /families/{familyId}/livestockCounts/{livestockCountId}: Livestock count data for a family.
 * - /infrastructures/{infrastructureId}: Infrastructure data.
 * - /resources/{resourceId}: Resource data.
 *  - /citizens/{citizenId}/reports/{reportId}: Report data for a specific citizen.
 *
 * Key Security Decisions:
 * - User data is strictly controlled by the user's ID.
 * - Family data is controlled at the family level.
 * - Top-level infrastructure and resource data is publicly readable.
 * - No user listing is allowed.
 *
 * Denormalization for Authorization:
 *  - citizenId and familyId are copied into child documents to enable fast and secure authorization checks without requiring additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the requested user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /families/{familyId} collection.
     * @path /families/{familyId}
     * @allow (read) - Any authenticated user can read a family document.
     * @allow (create, update, delete) - Only the authenticated user with the matching familyId can write.
     * @deny (create) - If the familyId in the request doesn't match the authenticated user's ID.
     * @principle Enforces family-level ownership for writes.
     */
    match /families/{familyId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.id == familyId;
      allow update: if isSignedIn() && resource.data.id == familyId;
      allow delete: if isSignedIn() && resource.data.id == familyId;
    }

    /**
     * @description Rules for the /families/{familyId}/citizens/{citizenId} collection.
     * @path /families/{familyId}/citizens/{citizenId}
     * @allow (read) - Any authenticated user can read a citizen document within a family.
     * @allow (create, update, delete) - Only the authenticated user with the matching citizenId can write.
     * @deny (create) - If the citizenId in the request doesn't match the authenticated user's ID.
     * @principle Enforces citizen-level ownership for writes within a family.
     */
    match /families/{familyId}/citizens/{citizenId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.id == citizenId;
      allow update: if isSignedIn() && resource.data.id == citizenId;
      allow delete: if isSignedIn() && resource.data.id == citizenId;
    }

    /**
     * @description Rules for the /citizens/{citizenId}/birthRegistrations/{birthRegistrationId} collection.
     * @path /citizens/{citizenId}/birthRegistrations/{birthRegistrationId}
     * @allow (read) - Only the owner of the citizen document can read their birth registrations.
     * @allow (create, update, delete) - Only the owner of the citizen document can write their birth registrations.
     * @deny (create) - If the citizenId in the request doesn't match the authenticated user's ID.
     * @principle Enforces document ownership for writes.
     */
    match /citizens/{citizenId}/birthRegistrations/{birthRegistrationId} {
      allow get, list: if isOwner(citizenId);
      allow create: if isOwner(citizenId) && request.resource.data.citizenId == citizenId;
      allow update: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
      allow delete: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
    }

    /**
     * @description Rules for the /citizens/{citizenId}/deathRegistrations/{deathRegistrationId} collection.
     * @path /citizens/{citizenId}/deathRegistrations/{deathRegistrationId}
     * @allow (read) - Only the owner of the citizen document can read their death registrations.
     * @allow (create, update, delete) - Only the owner of the citizen document can write their death registrations.
     * @deny (create) - If the citizenId in the request doesn't match the authenticated user's ID.
     * @principle Enforces document ownership for writes.
     */
    match /citizens/{citizenId}/deathRegistrations/{deathRegistrationId} {
      allow get, list: if isOwner(citizenId);
      allow create: if isOwner(citizenId) && request.resource.data.citizenId == citizenId;
      allow update: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
      allow delete: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
    }

    /**
     * @description Rules for the /citizens/{citizenId}/residencies/{residencyId} collection.
     * @path /citizens/{citizenId}/residencies/{residencyId}
     * @allow (read) - Only the owner of the citizen document can read their residencies.
     * @allow (create, update, delete) - Only the owner of the citizen document can write their residencies.
     * @deny (create) - If the citizenId in the request doesn't match the authenticated user's ID.
     * @principle Enforces document ownership for writes.
     */
    match /citizens/{citizenId}/residencies/{residencyId} {
      allow get, list: if isOwner(citizenId);
      allow create: if isOwner(citizenId) && request.resource.data.citizenId == citizenId;
      allow update: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
      allow delete: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
    }

    /**
     * @description Rules for the /citizens/{citizenId}/migrationHistories/{migrationHistoryId} collection.
     * @path /citizens/{citizenId}/migrationHistories/{migrationHistoryId}
     * @allow (read) - Only the owner of the citizen document can read their migration histories.
     * @allow (create, update, delete) - Only the owner of the citizen document can write their migration histories.
     * @deny (create) - If the citizenId in the request doesn't match the authenticated user's ID.
     * @principle Enforces document ownership for writes.
     */
    match /citizens/{citizenId}/migrationHistories/{migrationHistoryId} {
      allow get, list: if isOwner(citizenId);
      allow create: if isOwner(citizenId) && request.resource.data.citizenId == citizenId;
      allow update: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
      allow delete: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
    }

    /**
     * @description Rules for the /citizens/{citizenId}/employments/{employmentId} collection.
     * @path /citizens/{citizenId}/employments/{employmentId}
     * @allow (read) - Only the owner of the citizen document can read their employments.
     * @allow (create, update, delete) - Only the owner of the citizen document can write their employments.
     * @deny (create) - If the citizenId in the request doesn't match the authenticated user's ID.
     * @principle Enforces document ownership for writes.
     */
    match /citizens/{citizenId}/employments/{employmentId} {
      allow get, list: if isOwner(citizenId);
      allow create: if isOwner(citizenId) && request.resource.data.citizenId == citizenId;
      allow update: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
      allow delete: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
    }

    /**
     * @description Rules for the /families/{familyId}/householdIncomes/{householdIncomeId} collection.
     * @path /families/{familyId}/householdIncomes/{householdIncomeId}
     * @allow (read) - Any authenticated user can read a household income document within a family.
     * @allow (create, update, delete) - Only the authenticated user with the matching familyId can write.
     * @deny (create) - If the familyId in the request doesn't match the authenticated user's ID.
     * @principle Enforces family-level ownership for writes.
     */
    match /families/{familyId}/householdIncomes/{householdIncomeId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.familyId == familyId;
      allow update: if isSignedIn() && resource.data.familyId == familyId;
      allow delete: if isSignedIn() && resource.data.familyId == familyId;
    }

    /**
     * @description Rules for the /citizens/{citizenId}/skills/{skillId} collection.
     * @path /citizens/{citizenId}/skills/{skillId}
     * @allow (read) - Only the owner of the citizen document can read their skills.
     * @allow (create, update, delete) - Only the owner of the citizen document can write their skills.
     * @deny (create) - If the citizenId in the request doesn't match the authenticated user's ID.
     * @principle Enforces document ownership for writes.
     */
    match /citizens/{citizenId}/skills/{skillId} {
      allow get, list: if isOwner(citizenId);
      allow create: if isOwner(citizenId) && request.resource.data.citizenId == citizenId;
      allow update: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
      allow delete: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
    }

    /**
     * @description Rules for the /citizens/{citizenId}/loanSubsidyEligibilities/{loanSubsidyEligibilityId} collection.
     * @path /citizens/{citizenId}/loanSubsidyEligibilities/{loanSubsidyEligibilityId}
     * @allow (read) - Only the owner of the citizen document can read their loan subsidy eligibilities.
     * @allow (create, update, delete) - Only the owner of the citizen document can write their loan subsidy eligibilities.
     * @deny (create) - If the citizenId in the request doesn't match the authenticated user's ID.
     * @principle Enforces document ownership for writes.
     */
    match /citizens/{citizenId}/loanSubsidyEligibilities/{loanSubsidyEligibilityId} {
      allow get, list: if isOwner(citizenId);
      allow create: if isOwner(citizenId) && request.resource.data.citizenId == citizenId;
      allow update: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
      allow delete: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
    }

    /**
     * @description Rules for the /families/{familyId}/agriculturalProductions/{agriculturalProductionId} collection.
     * @path /families/{familyId}/agriculturalProductions/{agriculturalProductionId}
     * @allow (read) - Any authenticated user can read an agricultural production document within a family.
     * @allow (create, update, delete) - Only the authenticated user with the matching familyId can write.
     * @deny (create) - If the familyId in the request doesn't match the authenticated user's ID.
     * @principle Enforces family-level ownership for writes.
     */
    match /families/{familyId}/agriculturalProductions/{agriculturalProductionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.familyId == familyId;
      allow update: if isSignedIn() && resource.data.familyId == familyId;
      allow delete: if isSignedIn() && resource.data.familyId == familyId;
    }

    /**
     * @description Rules for the /families/{familyId}/livestockCounts/{livestockCountId} collection.
     * @path /families/{familyId}/livestockCounts/{livestockCountId}
     * @allow (read) - Any authenticated user can read a livestock count document within a family.
     * @allow (create, update, delete) - Only the authenticated user with the matching familyId can write.
     * @deny (create) - If the familyId in the request doesn't match the authenticated user's ID.
     * @principle Enforces family-level ownership for writes.
     */
    match /families/{familyId}/livestockCounts/{livestockCountId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.familyId == familyId;
      allow update: if isSignedIn() && resource.data.familyId == familyId;
      allow delete: if isSignedIn() && resource.data.familyId == familyId;
    }

    /**
     * @description Rules for the /infrastructures/{infrastructureId} collection.
     * @path /infrastructures/{infrastructureId}
     * @allow (read, list) - Any user can read infrastructure data.
     * @deny (create, update, delete) - No user can create, update, or delete infrastructure data.
     * @principle Public read-only access.
     */
    match /infrastructures/{infrastructureId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for the /resources/{resourceId} collection.
     * @path /resources/{resourceId}
     * @allow (read, list) - Any user can read resource data.
     * @deny (create, update, delete) - No user can create, update, or delete resource data.
     * @principle Public read-only access.
     */
    match /resources/{resourceId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for the /citizens/{citizenId}/reports/{reportId} collection.
     * @path /citizens/{citizenId}/reports/{reportId}
     * @allow (read) - Only the owner of the citizen document can read their reports.
     * @allow (create, update, delete) - Only the owner of the citizen document can write their reports.
     * @deny (create) - If the citizenId in the request doesn't match the authenticated user's ID.
     * @principle Enforces document ownership for writes.
     */
    match /citizens/{citizenId}/reports/{reportId} {
      allow get, list: if isOwner( citizenId);
      allow create: if isOwner( citizenId) && request.resource.data.citizenId == citizenId;
      allow update: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
      allow delete: if isExistingOwner(citizenId) && resource.data.citizenId == citizenId;
    }
    
    /**
     * @description Rules for the /regions/{regionId} collection.
     * @path /regions/{regionId}
     * @allow (read) - Any authenticated user can read region data.
     * @allow (write) - Any authenticated user can write to region data.
     * @principle Public read-write access for all authenticated users.
     */
    match /regions/{regionId} {
      allow read, write: if isSignedIn();
    }
    
    /**
     * @description Rules for the /organizations/{organizationId} collection.
     * @path /organizations/{organizationId}
     * @allow (read) - Any authenticated user can read organization data.
     * @allow (write) - Any authenticated user can write to organization data.
     * @principle Public read-write access for all authenticated users.
     */
    match /organizations/{organizationId} {
      allow read, write: if isSignedIn();
    }
  }
}
    