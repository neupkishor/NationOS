rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: These rules are temporary and insecure.
    // They allow all reads and writes to your database until March 22, 2027.
    // Replace with secure rules before deploying to production.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2027, 3, 22);
    }
  }
}
